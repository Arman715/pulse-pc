<Window x:Class="PulsePC.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulsePC"
        Title="Пульс ПК — обратная связь" Width="760" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="640" MinHeight="520" ShowInTaskbar="True"
        Background="{StaticResource Base}" Foreground="{StaticResource Ink1}"
        FontFamily="{StaticResource TextFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Поле ввода: тот же вид, что в «Замере до и после», но многострочное по желанию -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink1}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" Background="{StaticResource Raised}" BorderBrush="{StaticResource Ink3}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Ink1}"/>
                                <Setter TargetName="frame" Property="Background" Value="{StaticResource Base}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Звезда оценки: контур или заливка красной тушью -->
        <Style x:Key="Star" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource Ink4}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Base}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== ЗАГОЛОВОК ОКНА ===================== -->
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoLogo}" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                          Width="24" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Пульс ПК" Style="{StaticResource Brand}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{StaticResource LineStrong}" Margin="18,0,16,0"/>
                    <TextBlock x:Name="CaptionText" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click" ToolTip="Закрыть"/>
                <Rectangle Height="1" Fill="{StaticResource LineStrong}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- ===================== ЛИСТ ===================== -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,22,32,20" MaxWidth="680" HorizontalAlignment="Left">

                    <!-- Форма -->
                    <StackPanel x:Name="FormPanel">
                        <TextBlock x:Name="Heading" Style="{StaticResource Verdict}"/>
                        <TextBlock x:Name="Intro" Style="{StaticResource Body}" Margin="0,8,0,0"/>

                        <!-- Проблема: что случилось -->
                        <StackPanel x:Name="ProblemKind">
                            <local:TrackedText Source="ЧТО СЛУЧИЛОСЬ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                            <Rectangle Style="{StaticResource Hairline}"/>
                            <StackPanel Orientation="Horizontal" Margin="-12,10,0,0">
                                <RadioButton x:Name="KindError" Style="{StaticResource Range}" GroupName="Kind" Content="Ошибка или сбой" IsChecked="True"/>
                                <RadioButton x:Name="KindWrong" Style="{StaticResource Range}" GroupName="Kind" Content="Работает не так"/>
                                <RadioButton x:Name="KindIdea" Style="{StaticResource Range}" GroupName="Kind" Content="Неудобно, есть идея"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Отзыв: оценка -->
                        <StackPanel x:Name="ReviewStars" Visibility="Collapsed">
                            <local:TrackedText Source="ОЦЕНКА" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                            <Rectangle Style="{StaticResource Hairline}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <StackPanel x:Name="Stars" Orientation="Horizontal"/>
                                <TextBlock x:Name="StarsText" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <local:TrackedText x:Name="TextLabel" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                        <Rectangle Style="{StaticResource Hairline}"/>
                        <TextBox x:Name="TextInput" Style="{StaticResource Field}" Margin="0,12,0,0" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
                        <TextBlock x:Name="TextHint" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                        <!-- Снимки экрана -->
                        <StackPanel x:Name="ShotsBlock">
                            <local:TrackedText Source="СНИМКИ ЭКРАНА" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                            <Rectangle Style="{StaticResource Hairline}"/>
                            <WrapPanel x:Name="Shots" Margin="0,12,0,0"/>
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="BtnShotApp" Content="Снимок окна программы" Margin="0,0,10,8" Click="ShotApp_Click"
                                        ToolTip="Только окно Пульс ПК — другие программы и рабочий стол на снимок не попадут"/>
                                <Button x:Name="BtnShotScreen" Content="Снимок всего экрана" Margin="0,0,10,8" Click="ShotScreen_Click"
                                        ToolTip="Это окно на секунду спрячется. На снимок попадёт всё, что видно на экране"/>
                                <Button x:Name="BtnShotFile" Content="Добавить файл…" Margin="0,0,10,8" Click="ShotFile_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Можно вставить картинку из буфера обмена: Ctrl+V. Не больше шести снимков."/>
                        </StackPanel>

                        <!-- Сведения о программе -->
                        <StackPanel x:Name="ReportBlock">
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ReportLabel_Click">
                                <CheckBox x:Name="ChkReport" IsChecked="True" Margin="0,0,10,0"/>
                                <TextBlock Text="Приложить сведения о программе и компьютере" Foreground="{StaticResource Ink1}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="26,4,0,0" TextWrapping="Wrap">
                                <Run Text="Версия, процессор и видеокарта, какие части программы работают, последние записи журнала. Имя пользователя в путях скрывается."/>
                                <Hyperlink x:Name="ReportPreviewLink" Click="ReportPreview_Click" Foreground="{StaticResource Accent}"><Run Text="Посмотреть"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="ReportPreview" Style="{StaticResource Field}" Margin="0,10,0,0" Height="180" IsReadOnly="True" Visibility="Collapsed"
                                     FontFamily="{StaticResource Mono}" FontSize="11.5" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <local:TrackedText Source="КУДА ОТВЕТИТЬ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                        <Rectangle Style="{StaticResource Hairline}"/>
                        <TextBox x:Name="ContactBox" Style="{StaticResource Field}" Margin="0,12,0,0" MaxLength="200"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Необязательно: почта или ник в Telegram, если хотите получить ответ."/>
                    </StackPanel>

                    <!-- Итог -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                        <DockPanel>
                            <local:StateMarker x:Name="DoneMark" Level="Ok" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,11,12,0"/>
                            <TextBlock x:Name="DoneTitle" Style="{StaticResource Verdict}"/>
                        </DockPanel>
                        <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                        <!-- Где у человека почта: новое письмо открывается там (ссылка mailto: у большинства открывала просто браузер) -->
                        <WrapPanel x:Name="MailServices" Margin="0,16,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="BtnOpenFolder" Content="Показать архив" Margin="0,0,10,8" Click="OpenFolder_Click"/>
                            <Button x:Name="BtnCopyAddress" Content="Скопировать адрес" Margin="0,0,10,8" Click="CopyAddress_Click"/>
                            <Button x:Name="BtnCopyText" Content="Скопировать текст письма" Margin="0,0,10,8" Click="CopyText_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="CopyNote" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                        <!-- Просьба о звезде на GitHub -->
                        <Border x:Name="StarAsk" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Спасибо! Поможете программе ещё немного?"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="Поставьте Пульс ПК звезду на GitHub — так программу проще найти другим игрокам. Нужен аккаунт GitHub, это бесплатно."/>
                                <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Star_Click" Content="Поставить звезду на GitHub"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== НИЗ ===================== -->
            <Border Grid.Row="2" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,1,0,0" Padding="32,14,32,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Отмена" Margin="0,0,10,0" Click="Close_Click"/>
                        <Button x:Name="BtnSend" Style="{StaticResource Primary}" Click="Send_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="Footer" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
