<UserControl x:Class="PulsePC.Panels.VersionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Текст, который пропадает, если он пуст -->
        <Style x:Key="OptBody" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Tip" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="18,0,0,8"/>
        </Style>

        <!-- Поле ввода: рамка тушью, без скруглений и теней (как в «Замере до и после»). -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink1}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" Background="{StaticResource Raised}" BorderBrush="{StaticResource Ink2}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Ink1}"/>
                                <Setter TargetName="frame" Property="Background" Value="{StaticResource Base}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Ink4}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка таблицы версий: отметка, что это, установлено, последняя; ниже вывод и ссылки -->
        <DataTemplate x:Key="VersionRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,14,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:StateMarker Level="{Binding Level}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource OptCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Installed}" Style="{StaticResource MonoNum}" FontSize="14" Margin="0,1,2,0"/>
                        <TextBlock Text="{Binding InstalledNote}" Style="{StaticResource OptCaption}" TextAlignment="Right" Margin="0,2,2,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{Binding Latest}" Style="{StaticResource MonoNum}" FontSize="14" Foreground="{Binding LatestInk}" Margin="0,1,2,0"/>
                        <TextBlock Text="{Binding LatestNote}" Style="{StaticResource OptCaption}" TextAlignment="Right" Margin="0,2,2,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Verdict}" Style="{StaticResource OptBody}" Foreground="{Binding VerdictInk}" Margin="0,8,2,0"/>
                    <ItemsControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Links}" Focusable="False" Margin="0,6,0,0"
                                  Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Link}" Foreground="{StaticResource Ink1}" Content="{Binding Label}" Tag="{Binding}" ToolTip="{Binding Url}"
                                        Margin="0,0,20,0" Click="Link_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Смотрю версии…"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Свежие ли драйвер видеокарты, BIOS и сама программа. Драйвер и BIOS программа не скачивает и не ставит — только показывает, где их взять. Себя программа обновляет по вашей кнопке (или сама, если вы это разрешили) и только после проверки файла."/>

        <!-- ============ Таблица ============ -->
        <Grid Margin="0,24,0,6">
            <local:TrackedText Source="ВЕРСИИ" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="CheckedText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
        </Grid>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Grid Margin="0,8,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="установлена" TextAlignment="Right" Margin="0,0,2,0"/>
            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="последняя" TextAlignment="Right" Margin="0,0,2,0"/>
        </Grid>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"/>
        <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource VersionRow}" Focusable="False"/>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="BtnCheck" Content="Проверить сейчас" Margin="0,0,14,8" Click="BtnCheck_Click"/>
            <TextBlock x:Name="CheckNote" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="520"
                       Text="Спросит NVIDIA о драйвере для вашей видеокарты и источник обновлений о новой версии программы. Ничего о вас не передаётся."/>
        </WrapPanel>

        <!-- ============ Обновление программы ============ -->
        <StackPanel x:Name="UpdateBlock" Visibility="Collapsed">
            <local:TrackedText x:Name="UpdateLabel" Source="ПУЛЬС ПК" Style="{StaticResource Label}" Margin="0,24,0,6"/>
            <Rectangle Style="{StaticResource Hairline}" Margin="0,0,0,12"/>
            <ItemsControl x:Name="NotesList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Style="{StaticResource Body}" Text="—"/>
                            <TextBlock Style="{StaticResource Tip}" Text="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel x:Name="UpdateButtons" Margin="0,8,0,0">
                <!-- Подпись задаётся в коде (L.Pick): общий ключ «Обновить» переводится как «Refresh», а здесь нужно «Update». -->
                <Button x:Name="BtnUpdate" Style="{StaticResource Primary}" Margin="0,0,14,8" Click="BtnUpdate_Click"/>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="520"
                           Text="Программа скачает установщик, сверит его контрольную сумму и запустит его, а сама закроется. История и настройки сохранятся."/>
            </WrapPanel>
            <!-- Переносная версия: обновляется вручную, архивом со страницы выпусков -->
            <WrapPanel x:Name="PortableButtons" Margin="0,8,0,0" Visibility="Collapsed">
                <Button x:Name="BtnReleases" Style="{StaticResource Primary}" Content="Открыть страницу выпусков" Margin="0,0,14,8" Click="Releases_Click"/>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="520"
                           Text="Переносная версия обновляется вручную: скачайте архив PulsePC-Portable новой версии и распакуйте его поверх этой папки. Папка Data с историей и настройками останется."/>
            </WrapPanel>
            <local:ThinBar x:Name="Progress" Height="3" Fill="{StaticResource Ink1}" Margin="0,4,0,4" Visibility="Collapsed"/>

            <!-- Один вопрос — при первой найденной новой версии: ставить ли обновления самой -->
            <Border x:Name="AskBlock" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Устанавливать обновления сами?"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                               Text="Программа скачает новую версию в фоне, проверит контрольную сумму и подпись автора — так же, как по кнопке, — и поставит её, когда вы не играете: в первые минуты после запуска программы или когда вы отошли от компьютера. Во время игры — никогда. После обновления — короткое уведомление, что нового."/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="BtnAutoYes" Content="Да, ставить сами" Margin="0,0,10,8" Click="AutoYes_Click"/>
                        <Button x:Name="BtnAutoNo" Content="Нет, спрашивать меня" Margin="0,0,10,8" Click="AutoNo_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Ответ можно поменять в любой момент ниже, в «Проверке»."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ Что нового после обновления ============ -->
        <StackPanel x:Name="WhatsNewBlock" Visibility="Collapsed">
            <local:TrackedText x:Name="WhatsNewLabel" Source="ЧТО НОВОГО" Style="{StaticResource Label}" Margin="0,24,0,6"/>
            <Rectangle Style="{StaticResource Hairline}" Margin="0,0,0,12"/>
            <TextBlock x:Name="WhatsNewText" Style="{StaticResource Body}" Margin="0,0,0,8"/>
            <ItemsControl x:Name="WhatsNewList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Style="{StaticResource Body}" Text="—"/>
                            <TextBlock Style="{StaticResource Tip}" Text="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ============ Настройка проверки ============ -->
        <local:TrackedText Source="ПРОВЕРКА" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Проверять самой раз в сутки"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Через минуту после запуска и дальше раз в сутки. О новой версии скажет уведомление у часов — один раз на каждую версию и не во время игры."/>
                </StackPanel>
                <CheckBox x:Name="AutoToggle" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" Click="AutoToggle_Click"/>
            </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Устанавливать обновления сами"/>
                    <TextBlock x:Name="AutoInstallHint" Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Новая версия скачивается в фоне, проверяется так же, как по кнопке, и ставится, когда вы не играете. Во время игры — никогда."/>
                    <TextBlock x:Name="AutoInstallState" Style="{StaticResource OptCaption}" Margin="0,4,0,0"/>
                </StackPanel>
                <CheckBox x:Name="AutoInstallToggle" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" Click="AutoInstallToggle_Click"/>
            </Grid>
        </Border>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Margin="0,12">
                <TextBlock Style="{StaticResource RowTitle}" Text="Источник обновлений программы"/>
                <TextBlock x:Name="FeedHint" Style="{StaticResource Body}" Margin="0,2,0,10"
                           Text="Откуда программа узнаёт о своих новых версиях: адрес файла update.json (https://…/update.json) или репозиторий GitHub в виде «владелец/репозиторий». Пока источник не задан, новые версии нужно скачивать самому."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FeedBox" Style="{StaticResource Field}" TextChanged="FeedBox_TextChanged" KeyDown="FeedBox_KeyDown"/>
                    <Button x:Name="BtnFeed" Grid.Column="1" Content="Сохранить" Margin="10,0,2,0" Click="BtnFeed_Click" IsEnabled="False"/>
                </Grid>
                <TextBlock x:Name="FeedResult" Style="{StaticResource OptCaption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"
                   Text="Менять эти настройки и обновлять программу можно только с правами администратора."/>
        <TextBlock x:Name="Result" Style="{StaticResource OptCaption}" Margin="0,8,0,0"/>

        <!-- ============ BIOS ============ -->
        <local:TrackedText Source="КОГДА ОБНОВЛЯТЬ BIOS" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}" Margin="0,0,0,12"/>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Вы ставите новый процессор, а нынешний BIOS его не знает. Список поддерживаемых процессоров — на странице платы."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="В описании новой версии исправлено то, что мешает именно вам: зависания, работа памяти, уязвимость."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Если компьютер работает стабильно, обновлять BIOS не обязательно. Отключение питания во время прошивки может вывести плату из строя."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Margin="18,0,0,0"
                       Text="После прошивки настройки BIOS сбрасываются, в том числе профиль разгона памяти (XMP или EXPO): запишите их заранее и включите снова."/>
        </Grid>
    </StackPanel>
</UserControl>
