<UserControl x:Class="PulsePC.Panels.PhonePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC"
             xmlns:panels="clr-namespace:PulsePC.Panels">
    <UserControl.Resources>
        <!-- Строка совета: тире тушью и текст. -->
        <Style x:Key="Tip" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="18,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Панель выключена."/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Страница в домашней сети: пока идёт игра, на экране телефона видны FPS, загрузка процессора и видеокарты, память и пинг. В игру программа ничего не встраивает, поэтому у античитов нет к ней вопросов; по желанию можно включить и оверлей — отдельное окно поверх игры."/>

        <local:TrackedText Source="ВКЛЮЧЕНИЕ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Показывать панель в домашней сети"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="При первом включении Windows спросит разрешение — отметьте «Частные сети» и нажмите «Разрешить доступ». Сама программа правила доступа в сеть не создаёт и не меняет: решение за вами."/>
                </StackPanel>
                <CheckBox x:Name="Switch" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" Click="Switch_Click"/>
            </Grid>
        </Border>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"
                   Text="Менять можно только с правами администратора."/>
        <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"/>

        <!-- Адрес: виден, пока сервер работает -->
        <StackPanel x:Name="AddressBlock" Visibility="Collapsed">
            <local:TrackedText Source="АДРЕС ДЛЯ ТЕЛЕФОНА" Style="{StaticResource Label}" Margin="0,24,0,6"/>
            <Rectangle Style="{StaticResource Hairline}"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="QrFrame" BorderBrush="{StaticResource Ink1}" BorderThickness="1" Margin="0,0,24,0" VerticalAlignment="Top">
                    <panels:QrView x:Name="Qr"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HowTo" Style="{StaticResource Body}" Text="Наведите камеру телефона на код или наберите адрес в браузере телефона целиком:"/>
                    <TextBox x:Name="Url" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="-2,8,0,0"
                             FontFamily="{StaticResource Mono}" FontSize="19" Foreground="{StaticResource Ink1}" TextWrapping="Wrap"
                             SelectionBrush="{StaticResource Accent}" IsTabStop="False"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="Подключено" Margin="0,0,18,4"/>
                        <TextBlock x:Name="Devices" Grid.Column="1" Style="{StaticResource Caption}" Foreground="{StaticResource Ink1}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Последнее обращение" Margin="0,0,18,4"/>
                        <TextBlock x:Name="Last" Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Foreground="{StaticResource Ink1}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Сеть компьютера" Margin="0,0,18,0"/>
                        <TextBlock x:Name="Adapter" Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Foreground="{StaticResource Ink1}"/>
                    </Grid>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="BtnIphone" Style="{StaticResource Primary}" Content="Значок для iPhone" Margin="0,0,10,8" Click="BtnIphone_Click"
                                ToolTip="Сохранить профиль .mobileconfig: значок «Пульс ПК» на экране «Домой», открывается во весь экран"/>
                        <Button x:Name="BtnCopy" Content="Скопировать адрес" Margin="0,0,10,8" Click="BtnCopy_Click"/>
                        <Button x:Name="BtnKey" Content="Сменить ключ" Margin="0,0,10,8" Click="BtnKey_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Text="Последние знаки адреса — случайный ключ: без него страница не открывается. Смените ключ, если адрес увидел кто-то посторонний, — старый сразу перестанет работать."/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Что программа сама видит: брандмауэр закрыл подключения, устройство не из домашней сети -->
        <StackPanel x:Name="TroubleBlock" Visibility="Collapsed">
            <local:TrackedText Source="ЧТО МЕШАЕТ ТЕЛЕФОНУ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
            <Rectangle Style="{StaticResource Hairline}"/>
            <TextBlock x:Name="TroubleFound" Style="{StaticResource Body}" Foreground="{StaticResource Warn}" Margin="0,12,0,0"/>
        </StackPanel>

        <local:TrackedText Source="ЧТО ВИДНО НА ТЕЛЕФОНЕ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0"
                   Text="Крупно — FPS, название игры и сколько она идёт; ниже — загрузка процессора, загрузка и температура видеокарты, видеопамять, свободная память, пинг и график FPS за последние две минуты. Вне игры страница показывает, как компьютер работает сейчас. Числа обновляются раз в полторы секунды. Страница только показывает: управлять компьютером с телефона через неё нельзя."/>

        <local:TrackedText Source="ЕСЛИ СТРАНИЦА НЕ ОТКРЫВАЕТСЯ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}" Margin="0,0,0,12"/>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Телефон и компьютер должны быть подключены к одному роутеру: телефон — по Wi-Fi, компьютер — кабелем или по Wi-Fi, неважно. Гостевая сеть роутера и мобильный интернет не подойдут."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="На телефоне выключите VPN и «частный узел» (iCloud Private Relay и подобное): с ними телефон ищет компьютер в интернете, а не дома."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Сеть должна быть отмечена в Windows как частная: в общедоступной сети (кафе, гостиница, общий Wi-Fi) и через VPN панель не отвечает никому, кроме этого компьютера. Тип сети меняется в «Параметрах»: «Сеть и Интернет» → свойства подключения → «Частная сеть»."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="После обновления программы ключ в адресе стал длиннее. Старый QR-код и значок на телефоне не открываются — возьмите новый адрес в этом разделе."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="В запросе Windows нужно было отметить «Частные сети» и нажать «Разрешить доступ». Если запрос закрыли, Windows запомнила отказ. Исправить это можно в «Безопасности Windows»: «Брандмауэр и безопасность сети» → «Разрешить работу с приложением через брандмауэр» → «Изменить параметры» → строка «PulsePC», отметка «Частная»."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Адрес набирается целиком: с http:// в начале и ключом после номера порта. Проще навести камеру на код."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Margin="18,0,0,0" Text="Адрес компьютера в сети может смениться после перезагрузки роутера. Тогда страница покажет «нет связи» — откройте этот раздел и возьмите новый адрес."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Если всё так, а страница не открывается только когда компьютер на кабеле, — в роутере может быть включена «изоляция клиентов» (AP isolation, «изоляция беспроводных клиентов»): она не пускает устройства из Wi-Fi к компьютерам на кабеле. Её выключают в настройках Wi-Fi роутера."/>
        </Grid>
    </StackPanel>
</UserControl>
