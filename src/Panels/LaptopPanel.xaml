<UserControl x:Class="PulsePC.Panels.LaptopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Совет: маркер состояния, заголовок, текст. -->
        <DataTemplate x:Key="NoteRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="0,12">
                    <local:StateMarker Level="{Binding Level}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- Показание: название, значение моноширинным, пояснение. -->
        <DataTemplate x:Key="FactRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Foreground="{DynamicResource Ink1}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MonoNum}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="16,2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Читаю состояние ноутбука…"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Здесь то, что важно именно для ноутбука: питание, батарея, режим работы и фирменная программа производителя. Программа здесь ничего не меняет — только показывает и подсказывает, где переключить."/>
        <TextBlock x:Name="Machine" Style="{StaticResource Caption}" Margin="0,8,0,0"/>

        <local:TrackedText Source="СОВЕТЫ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="Notes" ItemTemplate="{StaticResource NoteRow}" Focusable="False"/>

        <local:TrackedText Source="БАТАРЕЯ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="BatteryFacts" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>
        <DockPanel Margin="0,12,0,0">
            <local:StateMarker x:Name="BatteryMarker" Level="Info" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <StackPanel>
                <TextBlock x:Name="BatteryTitle" Style="{StaticResource RowTitle}" TextWrapping="Wrap" Text="Читаю ёмкость батареи…"/>
                <TextBlock x:Name="BatteryText" Style="{StaticResource Body}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <local:TrackedText Source="РЕЖИМ ПИТАНИЯ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="ModeFacts" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Text="Режим Windows переключается в «Параметры → Система → Питание и батарея → Режим питания», отдельно для работы от зарядки и от батареи. Схему питания для игр программа переключает в разделе «Питание»."/>
        <Button x:Name="BtnPower" Content="Открыть раздел «Питание»" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnPower_Click"/>

        <local:TrackedText Source="УВЕДОМЛЕНИЯ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Предупреждать, если игра идёт от батареи"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Если игра запущена без зарядки или зарядку отключили во время игры — уведомление у часов, один раз за игру."/>
                </StackPanel>
                <CheckBox x:Name="Alert" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" IsEnabled="False" Click="Alert_Click"/>
            </Grid>
        </Border>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"
                   Text="Менять можно только с правами администратора."/>
    </StackPanel>
</UserControl>
