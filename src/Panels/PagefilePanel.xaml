<UserControl x:Class="PulsePC.Panels.PagefilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Строка показаний: название и пояснение слева, число справа. -->
        <DataTemplate x:Key="FactRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MonoNum}" VerticalAlignment="Top" Margin="24,3,2,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Читаю настройку файла подкачки…"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Файл подкачки — место на диске, куда Windows убирает данные, когда память заполнена. Без него игра или программа при нехватке памяти закрывается с ошибкой. Скорости он не добавляет: это страховка."/>

        <local:TrackedText Source="СЕЙЧАС" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="NowList" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>

        <local:TrackedText Source="В ИГРАХ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>
        <TextBlock x:Name="GamesEmpty" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"
                   Text="Записанных сессий пока нет. Поиграйте, не закрывая программу, — и здесь появится, хватало ли памяти."/>

        <local:TrackedText Source="РЕКОМЕНДАЦИЯ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <DockPanel Margin="0,12,0,0">
            <local:StateMarker x:Name="AdviceMark" Level="Info" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <StackPanel>
                <TextBlock x:Name="AdviceTitle" Style="{StaticResource RowTitle}" Text="—"/>
                <TextBlock x:Name="AdviceWhy" Style="{StaticResource Body}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <DockPanel x:Name="MemoryBlock" Margin="0,14,0,0" Visibility="Collapsed">
            <local:StateMarker Level="Warn" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <StackPanel>
                <TextBlock Style="{StaticResource RowTitle}" Text="Памяти в играх не хватает"/>
                <TextBlock x:Name="MemoryNote" Style="{StaticResource Body}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Style="{StaticResource Caption}" Margin="20,12,0,0"
                   Text="Настройка файла подкачки не прибавляет FPS. Она нужна, чтобы игра не закрывалась с ошибкой, когда память заканчивается."/>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="BtnApply" Style="{StaticResource Primary}" Content="Применить рекомендацию" Margin="0,0,10,8" IsEnabled="False" Click="BtnApply_Click"/>
            <Button x:Name="BtnRestore" Content="Вернуть как было" Margin="0,0,10,8" IsEnabled="False" Click="BtnRestore_Click"/>
        </WrapPanel>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"
                   Text="Менять можно только с правами администратора."/>
        <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
    </StackPanel>
</UserControl>
