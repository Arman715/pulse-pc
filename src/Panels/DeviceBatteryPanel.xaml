<UserControl x:Class="PulsePC.Panels.DeviceBatteryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Устройство с зарядом: значок типа, название и источник, слева; проценты, полоса и «заряжается» — справа. -->
        <DataTemplate x:Key="ChargeRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Icon}" Stroke="{Binding Brush}" StrokeThickness="1.3" Width="24" Height="24" Stretch="Uniform"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Top" Margin="0,1,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="132" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Path Data="{Binding Bolt}" Fill="{DynamicResource Ink2}" Width="9" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                  Margin="0,0,6,0" Visibility="{Binding BoltVisibility}"/>
                            <TextBlock Text="{Binding Value}" Style="{StaticResource Secondary}" FontSize="24" Foreground="{Binding Brush}"/>
                        </StackPanel>
                        <local:ThinBar Target="{Binding Fill}" Fill="{Binding Brush}" Height="4" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Устройство, заряд которого не прочитан: значок, название, где смотреть. -->
        <DataTemplate x:Key="NoteRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Icon}" Stroke="{DynamicResource Ink3}" StrokeThickness="1.3" Width="24" Height="24" Stretch="Uniform"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Top" Margin="0,1,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Источник заряда: название и пояснение. -->
        <DataTemplate x:Key="SourceRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Foreground="{DynamicResource Ink1}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" TextWrapping="Wrap" Text="Спрашиваю заряд устройств…"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Заряд беспроводной гарнитуры, мыши, клавиатуры и геймпада — чтобы мышь не выключилась посреди игры. Тот же заряд можно показывать в оверлее и в уведомлении перед игрой."/>

        <local:TrackedText Source="УСТРОЙСТВА" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="Known" ItemTemplate="{StaticResource ChargeRow}" Focusable="False"/>
        <TextBlock x:Name="NoneKnown" Style="{StaticResource Body}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Ни одно устройство сейчас не сообщает заряд."/>
        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="BtnRefresh" Content="Обновить" Margin="0,0,14,8" Click="Refresh_Click"/>
            <TextBlock x:Name="Checked" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
        </WrapPanel>

        <StackPanel x:Name="UnknownBlock" Visibility="Collapsed">
            <local:TrackedText Source="ЗАРЯД НЕ ЧИТАЕТСЯ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
            <Rectangle Style="{StaticResource Hairline}"/>
            <ItemsControl x:Name="Unknown" ItemTemplate="{StaticResource NoteRow}" Focusable="False"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Причина — у каждого устройства в строке. Устройствам, протокол которых программа не знает, она запросов не отправляет: неизвестная команда могла бы сбить их настройки. Их заряд показывает фирменная программа."/>
        </StackPanel>

        <local:TrackedText Source="УВЕДОМЛЕНИЯ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Напоминать о заряде перед игрой"/>
                    <TextBlock x:Name="RemindText" Style="{StaticResource Body}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="Remind" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0"
                          AutomationProperties.Name="Напоминать о заряде перед игрой" IsEnabled="False" Click="Remind_Click"/>
            </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Предупреждать, если заряд кончается во время игры"/>
                    <TextBlock x:Name="InGameText" Style="{StaticResource Body}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="InGame" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0"
                          AutomationProperties.Name="Предупреждать, если заряд кончается во время игры" IsEnabled="False" Click="InGame_Click"/>
            </Grid>
        </Border>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"
                   Text="Менять можно только с правами администратора."/>
        <WrapPanel Margin="0,12,0,0">
            <Button Content="Открыть «Оверлей»" Margin="0,0,10,8" Click="Overlay_Click"/>
        </WrapPanel>

        <local:TrackedText Source="ОТКУДА ЗАРЯД" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="Sources" ItemTemplate="{StaticResource SourceRow}" Focusable="False"/>
        <TextBlock x:Name="HowNote" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
