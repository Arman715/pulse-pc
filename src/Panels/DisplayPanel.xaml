<UserControl x:Class="PulsePC.Panels.DisplayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Строка раздела: нижняя волосяная линия. -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- Слово состояния справа от строки, рядом с маркером. -->
        <Style x:Key="StateWord" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="Margin" Value="8,0,2,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Строка «название — значение» в описании экрана. -->
        <DataTemplate x:Key="FactRow">
            <Border Style="{StaticResource Row}">
                <Grid Margin="0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Foreground="{StaticResource Ink2}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource MonoNum}" TextAlignment="Left" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,1,0,0"
                                   Visibility="{Binding MonoVisible}"/>
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Body}" Foreground="{StaticResource Ink1}" Visibility="{Binding TextVisible}"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding NoteVisible}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Один экран: имя, четыре показания, подробности, вывод и кнопки. -->
        <DataTemplate x:Key="ScreenBlock">
            <StackPanel Margin="0,0,0,8">
                <Grid Margin="0,24,0,6">
                    <local:TrackedText Source="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                                    </Grid>
                <Rectangle Style="{StaticResource Hairline}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PanelModel}" Margin="0,14,0,0"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Foreground="{Binding NowInk}" Typography.NumeralAlignment="Tabular">
                            <Run Text="{Binding NowText, Mode=OneWay}"/><Run Text="&#x202F;Гц" FontSize="14"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="частота сейчас, точно"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular">
                            <Run Text="{Binding MaxText, Mode=OneWay}"/><Run Text="&#x202F;Гц" FontSize="14"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding MaxCaption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular" Text="{Binding ResText}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ResCaption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Style="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular">
                            <Run Text="{Binding BitsText, Mode=OneWay}"/><Run Text="{Binding BitsUnit, Mode=OneWay}" FontSize="14"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="цвет на канал"/>
                    </StackPanel>
                </Grid>

                <Rectangle Style="{StaticResource Hairline}" Margin="0,18,0,0"/>
                <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>

                <DockPanel Margin="0,14,0,0">
                    <local:StateMarker Level="{Binding Level}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Verdict}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Advice}" Style="{StaticResource Body}" Margin="0,2,0,0" Visibility="{Binding AdviceVisible}"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,14,0,0" Visibility="{Binding ButtonsVisible}">
                    <Button Style="{StaticResource Primary}" Content="{Binding EnableText}" Tag="{Binding}" Margin="0,0,10,8"
                            Visibility="{Binding EnableVisible}" IsEnabled="{Binding CanChange}" Click="Enable_Click"/>
                    <Button Content="Вернуть как было" Tag="{Binding}" Margin="0,0,10,8"
                            Visibility="{Binding RestoreVisible}" IsEnabled="{Binding CanChange}" Click="Restore_Click"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Читаю режим экранов…"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Частота обновления — сколько раз в секунду монитор рисует новую картинку. Если она ниже, чем умеет монитор, лишние кадры игры до экрана не доходят, сколько бы FPS ни выдавала видеокарта."/>

        <!-- Ожидание подтверждения новой частоты -->
        <Border x:Name="PendingBox" Background="{StaticResource WarnTint}" Margin="0,16,0,0" Padding="14,12" Visibility="Collapsed">
            <DockPanel>
                <local:StateMarker Level="Warn" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <StackPanel>
                    <TextBlock x:Name="PendingTitle" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="PendingText" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="BtnKeep" Style="{StaticResource Primary}" Content="Оставить" Margin="0,0,10,0" Click="Keep_Click"/>
                        <Button x:Name="BtnReject" Content="Вернуть сейчас" Click="Reject_Click"/>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <ItemsControl x:Name="Screens" ItemTemplate="{StaticResource ScreenBlock}" Focusable="False"/>
        <TextBlock x:Name="NoScreens" Style="{StaticResource Body}" Margin="0,16,0,0" Visibility="Collapsed"
                   Text="Windows не отдала список экранов. Так бывает в удалённом рабочем столе и сразу после переподключения монитора — откройте раздел ещё раз."/>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed"
                   Text="Менять частоту можно только с правами администратора."/>

        <!-- Переменная частота -->
        <local:TrackedText Source="ПЕРЕМЕННАЯ ЧАСТОТА ОБНОВЛЕНИЯ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,12,0,4"
                   Text="С ней монитор подстраивается под FPS игры: картинка не рвётся и не подтормаживает, даже когда кадров меньше, чем герц. У NVIDIA это G-SYNC, у AMD — FreeSync, у Intel — Adaptive Sync."/>
        <Border Style="{StaticResource Row}">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SyncTitle" Style="{StaticResource RowTitle}" Text="G-SYNC в драйвере NVIDIA"/>
                    <TextBlock x:Name="SyncText" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,4,0,0">
                    <local:StateMarker x:Name="SyncMark" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncWord" Style="{StaticResource StateWord}" Text="—"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource Row}">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Переменная частота обновления в Windows"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Включает G-SYNC и FreeSync в играх DirectX 11, которые сами их не просят. Работает, только если переменная частота включена и в драйвере видеокарты."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,4,0,0">
                    <local:StateMarker x:Name="VrrMark" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VrrWord" Style="{StaticResource StateWord}" Text="—"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource Row}">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Оптимизации для оконных игр"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Игры в окне и в окне без рамки выводят кадры так же быстро, как в полноэкранном режиме, и тоже получают переменную частоту."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,4,0,0">
                    <local:StateMarker x:Name="WinOptMark" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WinOptWord" Style="{StaticResource StateWord}" Text="—"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="SyncWhere" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

        <!-- Слежение -->
        <local:TrackedText Source="СЛЕЖЕНИЕ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Border Style="{StaticResource Row}">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Предупреждать, если частота ниже возможной"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Программа проверяет частоту при своём запуске, при смене режима экрана и в начале игры. Если она ниже, чем умеет монитор, — уведомление у часов, не чаще раза в сутки для каждого экрана."/>
                </StackPanel>
                <CheckBox x:Name="Watch" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" IsEnabled="False"
                          Click="Watch_Click" AutomationProperties.Name="Предупреждать, если частота ниже возможной"/>
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                   Text="После смены частоты программа ждёт подтверждения 15 секунд. Если картинка пропала и нажать «Оставить» нельзя, прежняя частота вернётся сама."/>
    </StackPanel>
</UserControl>
