<UserControl x:Class="PulsePC.Panels.VisualPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Строка эффекта: название и пояснение слева, переключатель справа. -->
        <DataTemplate x:Key="FxRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Desired}" VerticalAlignment="Top" Margin="24,3,2,0"
                              AutomationProperties.Name="{Binding Title}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Читаю оформление…"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Анимации, прозрачность и тени Windows. На игровом компьютере с отдельной видеокартой FPS в играх от этого почти не вырастет: выигрыш — в отклике окон и меню. На слабых компьютерах и со встроенной графикой разница заметнее."/>

        <local:TrackedText Source="ПРОФИЛЬ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <!-- Сдвиг влево и обрезка прячут разделительную черту перед первым названием: подписи встают по левому краю листа. -->
        <Grid ClipToBounds="True" Margin="0,12,0,0">
            <StackPanel x:Name="Profiles" Orientation="Horizontal" Margin="-12,0,0,0">
                <RadioButton x:Name="ProfilePretty" Style="{StaticResource Range}" GroupName="VisualProfile" Content="Красиво" Click="Profile_Click"/>
                <RadioButton x:Name="ProfileBalance" Style="{StaticResource Range}" GroupName="VisualProfile" Content="Баланс" Click="Profile_Click"/>
                <RadioButton x:Name="ProfileSpeed" Style="{StaticResource Range}" GroupName="VisualProfile" Content="Скорость" Click="Profile_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ProfileNote" Style="{StaticResource Caption}" Margin="0,8,0,0"/>

        <local:TrackedText Source="ЭФФЕКТЫ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource FxRow}" Focusable="False"/>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="BtnApply" Style="{StaticResource Primary}" Content="Применить" Margin="0,0,10,8" IsEnabled="False" Click="Apply_Click"/>
            <Button x:Name="BtnRestore" Content="Вернуть как было" Margin="0,0,10,8" IsEnabled="False" Click="Restore_Click"/>
        </WrapPanel>
        <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"
                   Text="Менять можно только с правами администратора."/>
    </StackPanel>
</UserControl>
