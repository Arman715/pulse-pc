<UserControl x:Class="PulsePC.Panels.FansPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC"
             xmlns:panels="clr-namespace:PulsePC.Panels">
    <UserControl.Resources>
        <!-- Выбор режима: строка с кружком слева, как в разделе «Питание». -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
            <Setter Property="GroupName" Value="FanMode"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,14,0">
                                    <Ellipse x:Name="ring" Stroke="{StaticResource Ink2}" StrokeThickness="1.2"/>
                                    <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource Accent}" Opacity="0"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Ink1}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Ink1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Ink4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tip" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="18,0,0,8"/>
        </Style>
        <local:ChartZoom x:Key="FanZoom" Full="01:00:00"/>
        <!-- Строка таблицы «по играм» -->
        <DataTemplate x:Key="GameRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Game}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Avg}" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Max}" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding Temp}" Style="{StaticResource MonoNum}" Foreground="{Binding TempInk}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Читаю вентиляторы…"/>
        <TextBlock x:Name="Intro" Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Обороты вентиляторов видеокарты, сколько они крутятся в играх и вне их, и скорость по вашей кривой. Пока видеокарта холодная, драйвер обычно останавливает вентиляторы совсем — это нормально."/>
        <DockPanel x:Name="DustAlert" Visibility="Collapsed" Margin="0,14,0,0">
            <local:StateMarker Level="Warn" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <Button Style="{StaticResource Link}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" Content="Подробнее" Click="DustMore_Click"/>
            <TextBlock x:Name="DustAlertText" Style="{StaticResource Body}" Foreground="{StaticResource Warn}"/>
        </DockPanel>

        <!-- ======================================================== сейчас -->
        <local:TrackedText Source="СЕЙЧАС" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <UniformGrid Columns="4" Margin="0,14,0,0">
            <StackPanel>
                <local:NumberText x:Name="NowRpm" Style="{StaticResource Secondary}" Unit="об/мин" UnitSize="14"/>
                <TextBlock Style="{StaticResource Caption}" Text="обороты"/>
            </StackPanel>
            <StackPanel>
                <local:NumberText x:Name="NowLevel" Style="{StaticResource Secondary}" Unit="%" UnitSize="14"/>
                <TextBlock Style="{StaticResource Caption}" Text="скорость от максимальной"/>
            </StackPanel>
            <StackPanel>
                <local:NumberText x:Name="NowTemp" Style="{StaticResource Secondary}" Unit="°C" UnitSize="14"/>
                <TextBlock Style="{StaticResource Caption}" Text="температура видеокарты"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="NowWho" Style="{StaticResource Secondary}" FontSize="24" LineHeight="40" Text="—"/>
                <TextBlock Style="{StaticResource Caption}" Text="кто задаёт скорость"/>
            </StackPanel>
        </UniformGrid>
        <TextBlock x:Name="NowReason" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

        <!-- ======================================================== управление -->
        <local:TrackedText Source="УПРАВЛЕНИЕ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <DockPanel x:Name="NoControl" Visibility="Collapsed" Margin="0,12,0,0">
            <local:StateMarker Level="Info" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <TextBlock x:Name="NoControlText" Style="{StaticResource Body}"/>
        </DockPanel>

        <StackPanel x:Name="ControlBlock">
            <RadioButton x:Name="ModeDriver" Style="{StaticResource Choice}" Click="Mode_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Как решает драйвер"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Заводская настройка видеокарты: в простое вентиляторы стоят, под нагрузкой разгоняются по кривой производителя. Программа скорость не трогает."/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeCurve" Style="{StaticResource Choice}" Click="Mode_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="По своей кривой"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Скорость зависит от температуры видеокарты так, как вы зададите. Прохладнее — видеокарта дольше держит высокую частоту, тише — меньше шума."/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeFixed" Style="{StaticResource Choice}" Click="Mode_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Постоянная скорость"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                               Text="Вентиляторы крутятся ровно, без разгонов и замедлений: шум один и тот же. Если видеокарта всё же нагреется до 84&#160;°&#x2060;C, скорость станет полной."/>
                </StackPanel>
            </RadioButton>

            <!-- Кривая -->
            <StackPanel x:Name="CurveBlock" Visibility="Collapsed" Margin="0,16,0,0">
                <WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Готовые кривые:" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <Button x:Name="PresetQuiet" Content="Тише" Margin="0,0,8,8" Click="Preset_Click" ToolTip="Вентиляторы просыпаются с 50 °C и разгоняются плавно"/>
                    <Button x:Name="PresetBalanced" Content="Сбалансированно" Margin="0,0,8,8" Click="Preset_Click" ToolTip="Середина между шумом и температурой"/>
                    <Button x:Name="PresetCool" Content="Прохладнее" Margin="0,0,8,8" Click="Preset_Click" ToolTip="Вентиляторы крутятся раньше и быстрее: видеокарта холоднее, но громче"/>
                </WrapPanel>
                <panels:FanCurveView x:Name="Curve" Margin="0,6,0,0"/>
                <TextBlock x:Name="CurveHint" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="Перетащите квадраты мышью. С клавиатуры: щёлкните по графику, PageUp и PageDown выбирают точку, стрелки её двигают. Заштриховано — от 84&#160;°&#x2060;C вентиляторы всегда на полной скорости. Серая полоса снизу — медленнее вентиляторы этой видеокарты не крутятся."/>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,8,0,0">
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Останавливать вентиляторы, пока видеокарта холодная"/>
                            <TextBlock x:Name="StopHint" Style="{StaticResource Body}" Margin="0,2,0,0"
                                       Text="Ниже первой точки кривой скорость снова решает драйвер, и в простое вентиляторы стоят. Если выключить, они будут крутиться всегда, хотя бы медленно."/>
                        </StackPanel>
                        <CheckBox x:Name="StopCold" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" Click="Option_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Постоянная скорость -->
            <StackPanel x:Name="FixedBlock" Visibility="Collapsed" Margin="0,16,0,0" Orientation="Horizontal">
                <Button x:Name="FixedDown" Content="−5 %" Width="64" Click="Fixed_Click"/>
                <local:NumberText x:Name="FixedValue" Style="{StaticResource Secondary}" Unit="%" UnitSize="14" MinWidth="110" TextAlignment="Center" Margin="12,0" VerticalAlignment="Center"/>
                <Button x:Name="FixedUp" Content="+5 %" Width="64" Click="Fixed_Click"/>
            </StackPanel>

            <Border x:Name="GamesRow" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="Только во время игры"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0"
                                   Text="Ваша скорость действует, пока запущена игра. В остальное время вентиляторами управляет драйвер."/>
                    </StackPanel>
                    <CheckBox x:Name="GamesOnly" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Top" Margin="24,3,2,0" Click="Option_Click"/>
                </Grid>
            </Border>

            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="BtnApply" Style="{StaticResource Primary}" Content="Применить" Margin="0,0,10,8" Click="Apply_Click"/>
                <Button x:Name="BtnTest" Content="Проверить: полная скорость на 6 секунд" Margin="0,0,10,8" Click="Test_Click"
                        ToolTip="Вентиляторы разгонятся до максимума и вернутся к выбранному режиму — так слышно, что управление работает"/>
            </WrapPanel>
            <TextBlock x:Name="Pending" Style="{StaticResource Caption}" Foreground="{StaticResource Warn}" Visibility="Collapsed"
                       Text="Изменения ещё не применены."/>
            <TextBlock x:Name="AdminNote" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"
                       Text="Менять скорость можно только с правами администратора."/>
            <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ======================================================== статистика -->
        <Grid Margin="0,28,0,6">
            <local:TrackedText Source="СТАТИСТИКА" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="RangeHour" Style="{StaticResource Range}" GroupName="FanRange" Content="час" Tag="60" Checked="Range_Checked"/>
                <RadioButton x:Name="RangeDay" Style="{StaticResource Range}" GroupName="FanRange" Content="сутки" Tag="1440" Checked="Range_Checked" IsChecked="True"/>
                <RadioButton x:Name="RangeWeek" Style="{StaticResource Range}" GroupName="FanRange" Content="неделя" Tag="10080" Checked="Range_Checked"/>
            </StackPanel>
        </Grid>
        <Rectangle Style="{StaticResource Hairline}"/>
        <TextBlock x:Name="StatsEmpty" Style="{StaticResource Body}" Margin="0,12,0,0" Visibility="Collapsed"
                   Text="Статистика копится, пока программа запущена, в том числе свёрнутая к часам. Первые точки появятся через минуту."/>
        <StackPanel x:Name="StatsBody">
            <local:ChartZoomBar Title="ТЕМПЕРАТУРА И СКОРОСТЬ ВЕНТИЛЯТОРОВ, 0–100" TitleStyle="{StaticResource Label}" Zoom="{StaticResource FanZoom}" Margin="0,16,0,0"/>
            <local:LoadChart x:Name="StatsChart" Height="120" HatchGaps="True" Threshold="84" Margin="0,8,0,0" Zoom="{StaticResource FanZoom}"/>
            <Grid Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="14" Height="2" Fill="{StaticResource Ink1}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="температура видеокарты, °C" Style="{StaticResource Caption}" Margin="0,0,16,0"/>
                    <Rectangle Width="14" Height="2" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="скорость вентиляторов, %" Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="AxisFrom" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                    <TextBlock Text="—" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AxisTo" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Grid>

            <!-- В играх и вне игр -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="скорость в среднем" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="максимум скорости" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="обороты в среднем" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="вентиляторы стояли" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>

                <Border Grid.Row="1" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Margin="0,6,0,0"/>
                <StackPanel Grid.Row="1" Margin="0,14,0,8">
                    <TextBlock Style="{StaticResource RowTitle}" Text="В играх"/>
                    <TextBlock x:Name="GameTime" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBlock x:Name="GameAvg" Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                <TextBlock x:Name="GameMax" Grid.Row="1" Grid.Column="2" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                <TextBlock x:Name="GameRpm" Grid.Row="1" Grid.Column="3" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                <TextBlock x:Name="GameStop" Grid.Row="1" Grid.Column="4" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>

                <Border Grid.Row="2" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"/>
                <StackPanel Grid.Row="2" Margin="0,10,0,8">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Вне игр"/>
                    <TextBlock x:Name="IdleTime" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBlock x:Name="IdleAvg" Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                <TextBlock x:Name="IdleMax" Grid.Row="2" Grid.Column="2" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                <TextBlock x:Name="IdleRpm" Grid.Row="2" Grid.Column="3" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                <TextBlock x:Name="IdleStop" Grid.Row="2" Grid.Column="4" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            </Grid>
            <TextBlock x:Name="StatsNote" Style="{StaticResource Body}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- По играм — из записанных сессий -->
        <StackPanel x:Name="GamesBlock" Visibility="Collapsed">
            <local:TrackedText Source="ПО ИГРАМ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
            <Rectangle Style="{StaticResource Hairline}"/>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="скорость в среднем" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="максимум скорости" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="макс. температура" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
            </Grid>
            <Rectangle Style="{StaticResource Hairline}"/>
            <ItemsControl x:Name="GameList" ItemTemplate="{StaticResource GameRow}" Focusable="False"/>
        </StackPanel>

        <!-- ======================================================== пыль -->
        <local:TrackedText x:Name="DustHeader" Source="ПЫЛЬ: КАК БЫЛО И КАК СЕЙЧАС" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <DockPanel Margin="0,12,0,0">
            <local:StateMarker x:Name="DustMarker" Level="Info" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <TextBlock x:Name="DustText" Style="{StaticResource Body}" Text="Сравниваю с тем, как видеокарта охлаждалась раньше…"/>
        </DockPanel>
        <Grid x:Name="DustTable" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="104"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="в игре" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="в простое" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="разница" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="вентиляторы" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="5" Style="{StaticResource Caption}" Text="потребление" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Bottom"/>

            <Border Grid.Row="1" Grid.ColumnSpan="6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Margin="0,6,0,0"/>
            <StackPanel Grid.Row="1" Margin="0,14,0,8">
                <TextBlock Style="{StaticResource RowTitle}" Text="Как было"/>
                <TextBlock x:Name="DustBaseWhen" Style="{StaticResource Caption}"/>
            </StackPanel>
            <TextBlock x:Name="DustBaseGame" Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            <TextBlock x:Name="DustBaseIdle" Grid.Row="1" Grid.Column="2" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            <TextBlock x:Name="DustBaseDelta" Grid.Row="1" Grid.Column="3" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            <TextBlock x:Name="DustBaseFan" Grid.Row="1" Grid.Column="4" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            <TextBlock x:Name="DustBaseWatts" Grid.Row="1" Grid.Column="5" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,16,0,0"/>

            <Border Grid.Row="2" Grid.ColumnSpan="6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"/>
            <StackPanel Grid.Row="2" Margin="0,10,0,8">
                <TextBlock Style="{StaticResource RowTitle}" Text="Как сейчас"/>
                <TextBlock x:Name="DustNowWhen" Style="{StaticResource Caption}"/>
            </StackPanel>
            <TextBlock x:Name="DustNowGame" Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            <TextBlock x:Name="DustNowIdle" Grid.Row="2" Grid.Column="2" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            <TextBlock x:Name="DustNowDelta" Grid.Row="2" Grid.Column="3" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            <TextBlock x:Name="DustNowFan" Grid.Row="2" Grid.Column="4" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            <TextBlock x:Name="DustNowWatts" Grid.Row="2" Grid.Column="5" Style="{StaticResource MonoNum}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
        </Grid>
        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                   Text="Сравниваются только минуты игры, когда видеокарта загружена от 85&#160;%. Чтобы не принять за пыль летнюю жару, берётся разница между температурой в игре и в простое в те же дни. Опорный период — первые 7 дней, за которые набралось 120 минут такой игры; при смене режима вентиляторов он начинается заново."/>
        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="BtnCleaned" Content="Почистил" Margin="0,0,10,8" Click="Cleaned_Click"
                    ToolTip="Начать новый опорный период: следующие 7 дней станут образцом «как было»"/>
        </WrapPanel>
        <TextBlock x:Name="DustAdminNote" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"
                   Text="Отметить чистку можно только с правами администратора."/>
        <TextBlock x:Name="DustResult" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"/>

        <!-- ======================================================== корпус -->
        <local:TrackedText x:Name="CaseLabel" Source="ВЕНТИЛЯТОРЫ КОРПУСА И ПРОЦЕССОРА" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <TextBlock x:Name="CaseText" Style="{StaticResource Body}" Margin="0,12,0,0"/>
        <TextBlock x:Name="CaseHow" Style="{StaticResource Body}" Margin="0,8,0,0"/>

        <!-- ======================================================== защита -->
        <local:TrackedText Source="ЧТО ЗАЩИЩАЕТ ВИДЕОКАРТУ" Style="{StaticResource Label}" Margin="0,28,0,6"/>
        <Rectangle Style="{StaticResource Hairline}" Margin="0,0,0,12"/>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="От 84&#160;°&#x2060;C вентиляторы крутятся на полной скорости, что бы ни было задано."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="Если температура перестаёт читаться дольше 6 секунд, вентиляторы возвращаются драйверу."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Text="При выходе из программы и из Windows управление возвращается драйверу. Если программу закрыли через диспетчер задач, вентиляторы останутся на последней скорости до следующего запуска программы или до перезагрузки."/>
        </Grid>
        <Grid>
            <TextBlock Style="{StaticResource Body}" Text="—"/>
            <TextBlock Style="{StaticResource Tip}" Margin="18,0,0,0" Text="Сама видеокарта тоже следит за собой: перегревшись, она сбрасывает частоту, а не сгорает."/>
        </Grid>
    </StackPanel>
</UserControl>
