<UserControl x:Class="PulsePC.Panels.StatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Часть программы: маркер состояния, название и пояснение слева, состояние справа. -->
        <DataTemplate x:Key="PartRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:StateMarker Level="{Binding Level}" VerticalAlignment="Top" Margin="0,5,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,2,0,0" ToolTip="{Binding Tip}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource MonoNum}" Foreground="{Binding Ink}"
                               VerticalAlignment="Top" Margin="24,3,2,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Сведение о программе: название слева, значение справа. -->
        <DataTemplate x:Key="FactRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MonoNum}" TextAlignment="Left"
                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <DockPanel>
            <!-- Часть не работает дольше 10 минут: красная метка у вердикта и у раздела в списке -->
            <local:StateMarker x:Name="AlarmMark" Level="Bad" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,11,12,0" Visibility="Collapsed"/>
            <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Проверяю части программы…"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Какие части программы работают и когда последний раз ошиблись. Если что-то не так, скопируйте отчёт и приложите его к вопросу на странице программы: по нему видно, что сломалось."/>

        <local:TrackedText Source="ЧАСТИ ПРОГРАММЫ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="PartList" ItemTemplate="{StaticResource PartRow}" Focusable="False"/>
        <TextBlock x:Name="PartsEmpty" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"
                   Text="Части программы ещё не отметились. Обычно это занимает несколько секунд после запуска."/>

        <local:TrackedText Source="О ПРОГРАММЕ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <ItemsControl x:Name="FactList" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>

        <DockPanel Margin="0,24,0,6">
            <TextBlock x:Name="LogPath" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            <local:TrackedText Source="ЖУРНАЛ · ПОСЛЕДНИЕ 30 СТРОК" Style="{StaticResource Label}"/>
        </DockPanel>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Raised}" Padding="14,10">
            <TextBlock x:Name="LogText" FontFamily="{StaticResource Mono}" FontSize="11.5" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                       Foreground="{StaticResource Ink3}" TextWrapping="Wrap"/>
        </Border>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="BtnLog" Margin="0,0,10,8" Click="BtnLog_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="M4,1.5 H12.5 L16,5 V18.5 H4 Z M12.5,1.5 V5 H16 M7,9 H13 M7,12 H13 M7,15 H11" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Открыть журнал"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnReport" Margin="0,0,10,8" Click="BtnReport_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="M6,5 H17 V18.5 H6 Z M3,15 V1.5 H14" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Скопировать отчёт"/>
                </StackPanel>
            </Button>
        </WrapPanel>
        <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
