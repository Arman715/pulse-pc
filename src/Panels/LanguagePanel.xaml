<UserControl x:Class="PulsePC.Panels.LanguagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <!-- Раздел двуязычный: его должен понять и тот, кто не читает на текущем языке. -->
        <TextBlock x:Name="State" Style="{StaticResource Verdict}"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" x:Name="Intro"/>

        <local:TrackedText x:Name="ChoiceLabel" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <StackPanel Margin="0,14,0,0">
            <RadioButton x:Name="OptRu" GroupName="Lang" Margin="0,0,0,10" Click="Option_Click">
                <!-- Подписи двуязычные и задаются в коде (LanguagePanel.xaml.cs): на любом языке интерфейса их поймут оба. -->
                <StackPanel>
                    <TextBlock x:Name="RuTitle" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="RuCaption" Style="{StaticResource Caption}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OptEn" GroupName="Lang" Margin="0,0,0,10" Click="Option_Click">
                <StackPanel>
                    <TextBlock x:Name="EnTitle" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="EnCaption" Style="{StaticResource Caption}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OptAuto" GroupName="Lang" Click="Option_Click">
                <StackPanel>
                    <TextBlock x:Name="AutoTitle" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="AutoCaption" Style="{StaticResource Caption}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <StackPanel x:Name="RestartBlock" Visibility="Collapsed" Margin="0,18,0,0">
            <TextBlock x:Name="RestartText" Style="{StaticResource Body}" Foreground="{StaticResource Ink1}"/>
            <Button x:Name="BtnRestart" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Restart_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
