<UserControl x:Class="PulsePC.Panels.BenchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulsePC">
    <UserControl.Resources>
        <!-- Поле ввода метки: рамка тушью, без скруглений и теней. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink1}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" Background="{StaticResource Raised}" BorderBrush="{StaticResource Ink2}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Ink1}"/>
                                <Setter TargetName="frame" Property="Background" Value="{StaticResource Base}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Ink4}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Отметка выбора замера для сравнения: квадрат, выбранный залит тушью. -->
        <Style x:Key="Pick" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Width="28" Height="24">
                            <Rectangle x:Name="box" Width="16" Height="16" Stroke="{StaticResource Ink2}" StrokeThickness="1" HorizontalAlignment="Left" SnapsToDevicePixels="True"/>
                            <Rectangle x:Name="dot" Width="8" Height="8" Fill="{StaticResource Ink1}" HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="Stroke" Value="{StaticResource Ink1}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="box" Property="Stroke" Value="{StaticResource Ink1}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Head" TargetType="local:TrackedText" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="State" Style="{StaticResource Verdict}" Text="Замеров пока нет."/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                   Text="Замер на полминуты показывает, сколько ресурсов отнимают фоновые программы и как быстро работают процессор, память и диск. Сделайте замер до настройки и ещё один после — программа покажет разницу. Видеокарту замер не нагружает."/>

        <local:TrackedText Source="НОВЫЙ ЗАМЕР" Style="{StaticResource Label}" Margin="0,24,0,6"/>
        <Rectangle Style="{StaticResource Hairline}"/>
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ReadingLabel}" Text="Метка" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBox x:Name="LabelBox" Grid.Column="1" Style="{StaticResource Field}" Width="230" MaxLength="40" Text="до"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Button Style="{StaticResource Link}" Content="до" Tag="до" Click="Preset_Click" Margin="0,0,16,0"/>
                <Button Style="{StaticResource Link}" Content="после" Tag="после" Click="Preset_Click"/>
            </StackPanel>
        </Grid>
        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="BtnRun" Style="{StaticResource Primary}" Content="Сделать замер" Margin="0,0,10,8" Click="BtnRun_Click"/>
            <Button x:Name="BtnCancel" Content="Отменить" Margin="0,0,10,8" Visibility="Collapsed" Click="BtnCancel_Click"/>
        </WrapPanel>
        <TextBlock x:Name="RunNote" Style="{StaticResource Caption}" Margin="0,2,0,0"
                   Text="Перед замером закройте игры и на полминуты оставьте компьютер в покое: движение мыши и работающие программы искажают числа."/>

        <!-- Ход замера -->
        <StackPanel x:Name="ProgressBlock" Visibility="Collapsed" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="ProgressPct" DockPanel.Dock="Right" Style="{StaticResource MonoNum}" Text="0 %" Margin="16,0,0,0"/>
                <TextBlock x:Name="ProgressStage" Style="{StaticResource RowTitle}"/>
            </DockPanel>
            <local:ThinBar x:Name="ProgressBar" Height="4" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Result" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"/>

        <!-- Список замеров -->
        <StackPanel x:Name="ListBlock" Visibility="Collapsed">
            <local:TrackedText Source="ЗАМЕРЫ" Style="{StaticResource Label}" Margin="0,26,0,6"/>
            <Rectangle Height="1" Fill="{StaticResource Ink1}" SnapsToDevicePixels="True"/>
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:TrackedText Source="БЫЛО" Style="{StaticResource Head}"/>
                <local:TrackedText Grid.Column="1" Source="СТАЛО" Style="{StaticResource Head}"/>
                <local:TrackedText Grid.Column="2" Source="ЗАМЕР И УСЛОВИЯ" Style="{StaticResource Head}"/>
            </Grid>
            <Rectangle Height="1" Fill="{StaticResource Ink1}" SnapsToDevicePixels="True"/>
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="pickBefore" Style="{StaticResource Pick}" Click="PickBefore_Click" ToolTip="Взять этот замер как «было»"/>
                                <Button x:Name="pickAfter" Grid.Column="1" Style="{StaticResource Pick}" Click="PickAfter_Click" ToolTip="Взять этот замер как «стало»"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Conditions}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource Link}" Content="Удалить" VerticalAlignment="Center" Margin="16,0,2,0" Click="Delete_Click"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBefore}" Value="True"><Setter TargetName="pickBefore" Property="Tag" Value="on"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsAfter}" Value="True"><Setter TargetName="pickAfter" Property="Tag" Value="on"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ListNote" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Хранятся последние 20 замеров."/>
        </StackPanel>

        <!-- Сравнение -->
        <StackPanel x:Name="CompareBlock" Visibility="Collapsed">
            <local:TrackedText x:Name="CompareTitle" Source="СРАВНЕНИЕ" Style="{StaticResource Label}" Margin="0,26,0,6"/>
            <Rectangle Height="1" Fill="{StaticResource Ink1}" SnapsToDevicePixels="True"/>
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="176"/>
                </Grid.ColumnDefinitions>
                <local:TrackedText Source="ПОКАЗАТЕЛЬ" Style="{StaticResource Head}"/>
                <local:TrackedText Grid.Column="1" Source="БЫЛО" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                <local:TrackedText Grid.Column="2" Source="СТАЛО" Style="{StaticResource Head}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                <local:TrackedText Grid.Column="3" Source="ИЗМЕНЕНИЕ" Style="{StaticResource Head}" Margin="14,0,0,0"/>
            </Grid>
            <Rectangle Height="1" Fill="{StaticResource Ink1}" SnapsToDevicePixels="True"/>
            <ItemsControl x:Name="Deltas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="176"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,8,12,9">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Title}"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Hint}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Line}" HorizontalAlignment="Left" SnapsToDevicePixels="True"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MonoNum}" Text="{Binding Before}" Foreground="{StaticResource Ink2}" Margin="0,0,14,0"/>
                                <Rectangle Grid.Column="2" Width="1" Fill="{StaticResource Line}" HorizontalAlignment="Left" SnapsToDevicePixels="True"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource MonoNum}" Text="{Binding After}" Margin="0,0,14,0"/>
                                <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Line}" HorizontalAlignment="Left" SnapsToDevicePixels="True"/>
                                <StackPanel Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <local:StateMarker Level="Warn" VerticalAlignment="Center" Margin="0,1,7,0" Visibility="{Binding Marker}"/>
                                        <TextBlock FontFamily="{StaticResource TextFont}" FontSize="13.5" Text="{Binding Word}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MonoNum}" TextAlignment="Left" HorizontalAlignment="Left" Text="{Binding Change}" Foreground="{Binding ChangeBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Rectangle Height="1" Fill="{StaticResource Ink1}" SnapsToDevicePixels="True" Margin="0,-1,0,0"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Body}" Foreground="{StaticResource Ink1}" FontSize="14.5" LineHeight="21" Margin="0,16,0,0"/>
            <TextBlock x:Name="CompareNote" Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Text="«Без изменений» — разница в пределах обычного разброса: два замера подряд тоже немного отличаются, и настройка тут ни при чём."/>
        </StackPanel>

        <TextBlock Style="{StaticResource Body}" Margin="0,22,0,0"
                   Text="Изменение FPS в играх этот замер не покажет — для этого сравните сессии на вкладке «Сессии». Здесь — только система вокруг игры."/>
    </StackPanel>
</UserControl>
