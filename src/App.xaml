<Application x:Class="PulsePC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Цвета листа «Чертёж» ============
                 Бумага и тушь. Красный — карандаш проверяющего: только выбор, выноски, живой сигнал и главное действие.
                 Предупреждение (охра) и ошибка (кармин) отличаются от красного тоном и всегда идут с квадратным маркером. -->
            <SolidColorBrush x:Key="Base" Color="#F2EEE5"/>
            <SolidColorBrush x:Key="Raised" Color="#F8F5EE"/>
            <SolidColorBrush x:Key="Track" Color="#E9E4D8"/>
            <SolidColorBrush x:Key="Line" Color="#CFC7B8"/>
            <SolidColorBrush x:Key="LineStrong" Color="#A39B8C"/>
            <SolidColorBrush x:Key="GridMinor" Color="#E4DED2"/>
            <SolidColorBrush x:Key="GridMajor" Color="#D3CBBB"/>
            <SolidColorBrush x:Key="Ink1" Color="#1A1917"/>
            <SolidColorBrush x:Key="Ink2" Color="#45423C"/>
            <SolidColorBrush x:Key="Ink3" Color="#6F6A60"/>
            <SolidColorBrush x:Key="Ink4" Color="#A8A194"/>
            <SolidColorBrush x:Key="Accent" Color="#C23B22"/>
            <SolidColorBrush x:Key="Lime" Color="#C23B22"/>
            <SolidColorBrush x:Key="RedHover" Color="#A93219"/>
            <SolidColorBrush x:Key="RedPressed" Color="#8F2914"/>
            <SolidColorBrush x:Key="RedTint" Color="#F3DFD6"/>
            <SolidColorBrush x:Key="Warn" Color="#95580F"/>
            <SolidColorBrush x:Key="WarnTint" Color="#F1E3C8"/>
            <SolidColorBrush x:Key="Bad" Color="#9E1B32"/>
            <SolidColorBrush x:Key="BadTint" Color="#F1D9DC"/>
            <SolidColorBrush x:Key="OnRed" Color="#FBF8F2"/>
            <!-- Рамка окна (в тёмной теме — темнее, см. Theme.cs) -->
            <SolidColorBrush x:Key="WindowEdge" Color="#BDB5A6"/>

            <FontFamily x:Key="Din">Bahnschrift</FontFamily>
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
            <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
            <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Пунктир «линия построения»: фокус с клавиатуры -->
            <Style x:Key="FocusDash">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" Stroke="{DynamicResource Ink1}" StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Текст ============ -->
            <Style x:Key="SheetTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="44"/>
                <Setter Property="LineHeight" Value="44"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Подзаголовок листа: капс с разрядкой второго уровня -->
            <Style x:Key="Tracked" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="LineHeight" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <!-- Метка группы: капс с разрядкой первого уровня -->
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="LineHeight" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="HeroXL" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="88"/>
                <Setter Property="LineHeight" Value="84"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="Hero" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="64"/>
                <Setter Property="LineHeight" Value="62"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="LineHeight" Value="40"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="Reading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="LineHeight" Value="28"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="Verdict" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="LineHeight" Value="30"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="PanelModel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="LineHeight" Value="26"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="PanelSection" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="ReadingLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="LineHeight" Value="20"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
            </Style>
            <Style x:Key="MonoNum" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="Brand" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
            </Style>
            <Style x:Key="Footer" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="Stamp" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StripLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
            </Style>
            <Style x:Key="StripValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Din}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="LineHeight" Value="32"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
            <Style x:Key="Hairline" TargetType="Rectangle">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Fill" Value="{DynamicResource Line}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Пиктограмма-контур: тонкое перо туши, без заливки -->
            <Style x:Key="Icon" TargetType="Path">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}, FallbackValue={StaticResource Ink1}}"/>
                <Setter Property="StrokeThickness" Value="1.25"/>
                <Setter Property="StrokeLineJoin" Value="Miter"/>
                <Setter Property="StrokeStartLineCap" Value="Square"/>
                <Setter Property="StrokeEndLineCap" Value="Square"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="False"/>
            </Style>

            <!-- ============ Подсказка ============ -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Raised}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Ink1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter MaxWidth="360"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Кнопки ============ -->
            <!-- Обычная (контур): рамка тушью, наведение — утопленная бумага, нажатие — сдвиг на 1 px. -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Ink1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="root">
                                <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                <Rectangle x:Name="frame" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                                <Border x:Name="hover" Background="{DynamicResource Track}" CornerRadius="2" Opacity="0" Margin="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/></Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="root" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="frame" Property="StrokeDashArray" Value="2 2"/>
                                    <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource Ink4}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Ink4}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Outline" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>

            <!-- Главное действие листа: единственная красная кнопка. -->
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnRed}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="root">
                                <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource RedHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource RedPressed}"/>
                                    <Setter TargetName="root" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource Track}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Ink4}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Необратимое действие: кармин. -->
            <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
            </Style>

            <!-- Текстовая кнопка и ссылка: без рамки, при наведении — подчёркивание. -->
            <Style x:Key="Link" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,2,0,3"/>
                                <Rectangle x:Name="under" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Ink1}" Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                                    <Setter TargetName="under" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Ink4}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ячейка нижней полосы «Обзора»: без рамки, наведение — утопленная бумага и красная черта снизу. -->
            <Style x:Key="StripCell" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="root" Background="Transparent">
                                <Border x:Name="hover" Background="{DynamicResource Track}" Opacity="0"/>
                                <Rectangle Width="1" Fill="{DynamicResource Line}" HorizontalAlignment="Right" Margin="0,12"/>
                                <ContentPresenter Margin="16,14,18,12"/>
                                <Rectangle x:Name="mark" Height="2" Fill="{DynamicResource Accent}" VerticalAlignment="Bottom" Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hover" Property="Opacity" Value="1"/>
                                    <Setter TargetName="mark" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="root" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кнопки управления окном -->
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Track}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnRed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Вкладка: пиктограмма (в Tag) и подпись; у выбранной — красная тушь и полужирный.
                 Невидимая полужирная копия подписи держит ширину, чтобы соседи не сдвигались. -->
            <Style x:Key="Tab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="pad" Background="Transparent" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="glyph" Data="{TemplateBinding Tag}" Width="16" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.25" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Visibility="Hidden"/>
                                        <TextBlock x:Name="text" Text="{TemplateBinding Content}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <!-- Узкое окно: вкладки без пиктограмм и плотнее (MainWindow.FitTitle убирает Tag) -->
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="pad" Property="Padding" Value="9,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink1}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource RedHover}"/></Trigger>
                </Style.Triggers>
            </Style>

            <!-- Выбор отрезка времени: подписи через тонкие вертикали, выбранная — полужирная с красной чертой -->
            <Style x:Key="Range" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid Margin="12,2,12,6">
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Visibility="Hidden"/>
                                    <TextBlock x:Name="text" Text="{TemplateBinding Content}" HorizontalAlignment="Center"/>
                                </Grid>
                                <Rectangle x:Name="mark" Height="2" Fill="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="12,0" Opacity="0"/>
                                <Rectangle Width="1" Height="12" Fill="{DynamicResource Line}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,4"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="mark" Property="Opacity" Value="1"/>
                                    <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink1}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink1}"/></Trigger>
                </Style.Triggers>
            </Style>

            <!-- Строка списков (сессии, игры, компоненты): выбранная — красная рамка, розоватая заливка -->
            <Style x:Key="CompItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Rectangle Style="{StaticResource Hairline}" VerticalAlignment="Bottom" x:Name="sep"/>
                                <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" MinHeight="44">
                                    <ContentPresenter Margin="12,9,12,9" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Track}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource RedTint}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="sep" Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Foreground" Value="{DynamicResource RedHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompItemText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
            </Style>

            <!-- ============ Флажок: квадрат, при выборе залит тушью ============ -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Ink1}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Rectangle x:Name="box" Width="16" Height="16" Stroke="{DynamicResource Ink2}" StrokeThickness="1" Fill="Transparent" SnapsToDevicePixels="True"/>
                                <Path x:Name="tick" Width="16" Height="16" Data="M 3.5,8 L 6.7,11 L 12.5,4.5" Stroke="{DynamicResource Base}" StrokeThickness="1.8" Visibility="Collapsed"
                                      StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="Stroke" Value="{DynamicResource Ink1}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Fill" Value="{DynamicResource Ink1}"/>
                                    <Setter TargetName="box" Property="Stroke" Value="{DynamicResource Ink1}"/>
                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="box" Property="Stroke" Value="{DynamicResource Ink4}"/>
                                    <Setter TargetName="box" Property="StrokeDashArray" Value="2 2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Переключатель: прямоугольный, бегунок-квадрат переезжает за 140 мс -->
            <Style x:Key="Toggle" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusDash}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="36" Height="18" Background="Transparent" SnapsToDevicePixels="True">
                                <Rectangle x:Name="track" Stroke="{DynamicResource Ink2}" StrokeThickness="1"/>
                                <Rectangle x:Name="on" Fill="{DynamicResource Ink1}" Opacity="0"/>
                                <Rectangle x:Name="thumbOff" Width="12" Height="12" Stroke="{DynamicResource Ink2}" StrokeThickness="1" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="thumbOn" Width="12" Height="12" Fill="{DynamicResource Base}" HorizontalAlignment="Left" Margin="3,0,0,0" Opacity="0">
                                    <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="track" Property="Stroke" Value="{DynamicResource Ink1}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="track" Property="Stroke" Value="{DynamicResource Ink4}"/>
                                    <Setter TargetName="track" Property="StrokeDashArray" Value="2 2"/>
                                    <Setter TargetName="thumbOff" Property="Stroke" Value="{DynamicResource Ink4}"/>
                                    <Setter TargetName="on" Property="Fill" Value="{DynamicResource Ink4}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Полоса прокрутки: линия-дорожка и узкая ручка ============ -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Rectangle Width="1" Fill="{DynamicResource Line}" HorizontalAlignment="Center"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent">
                                                        <Rectangle x:Name="t" Width="3" Fill="{DynamicResource Ink3}" Opacity="0.6" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="t" Property="Fill" Value="{DynamicResource Ink2}"/>
                                                            <Setter TargetName="t" Property="Width" Value="4"/>
                                                            <Setter TargetName="t" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
