<Window x:Class="PulsePC.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulsePC"
        xmlns:bp="clr-namespace:PulsePC.Blueprint"
        Title="Пульс ПК — первичный осмотр" Width="1000" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Base}" Foreground="{StaticResource Ink1}"
        FontFamily="{StaticResource TextFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource Base}" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== ЗАГОЛОВОК ОКНА ===================== -->
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoLogo}" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                          Width="24" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Пульс ПК" Style="{StaticResource Brand}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{StaticResource LineStrong}" Margin="18,0,16,0"/>
                    <TextBlock Text="Первичный осмотр" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click" ToolTip="Закрыть"/>
                <Rectangle Height="1" Fill="{StaticResource LineStrong}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- ===================== ЛИСТ ===================== -->
            <Grid Grid.Row="1" Margin="32,18,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <local:SheetHeader x:Name="Header" Title="ОСМОТР" Line1="ПЕРВИЧНЫЙ · СИСТЕМА ЦЕЛИКОМ" Line2=""/>

                <!-- Фаза 1: идёт осмотр -->
                <Grid x:Name="ScanPhase" Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="372"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Margin="0,0,28,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="StepCounter" DockPanel.Dock="Right" Style="{StaticResource Stamp}" Foreground="{StaticResource Ink3}"/>
                            <local:TrackedText Source="ПОРЯДОК ОСМОТРА" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Rectangle DockPanel.Dock="Top" Style="{StaticResource Hairline}" Fill="{StaticResource LineStrong}"/>
                        <!-- На низком экране окно ужимается (WindowFit) — список шагов тогда прокручивается -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="StepList"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Rectangle Grid.Column="1" Fill="{StaticResource Line}" Margin="0,4,0,18"/>

                    <Grid Grid.Column="2" Margin="28,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ClipToBounds="True">
                            <local:PlusGrid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,8" Rows="4" Cols="3" Step="28" Opacity="0.6"
                                            Mask="x..|xx.|xxx|xx." IsHitTestVisible="False"/>
                            <bp:BlueprintView x:Name="Drawing" Scene="Pc" DrawingPadding="116,8,182,8" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,6,0,18">
                            <local:ScanRuler x:Name="Progress" Height="22"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="Elapsed" DockPanel.Dock="Right" Style="{StaticResource Stamp}" Foreground="{StaticResource Ink3}"/>
                                <TextBlock x:Name="NowText" Style="{StaticResource Caption}" Foreground="{StaticResource Ink2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Фаза 2: паспорт и замечания -->
                <Grid x:Name="ResultPhase" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Margin="0,0,28,0">
                        <local:TrackedText DockPanel.Dock="Top" Source="ПАСПОРТ" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <Rectangle DockPanel.Dock="Top" Style="{StaticResource Hairline}" Fill="{StaticResource LineStrong}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                            <ScrollViewer.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="Black"/><GradientStop Offset="0.93" Color="Black"/><GradientStop Offset="1" Color="Transparent"/></LinearGradientBrush></ScrollViewer.OpacityMask>
                            <Grid x:Name="PassportGrid" Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <Rectangle Grid.Column="1" Fill="{StaticResource Line}" Margin="0,4,0,18"/>

                    <DockPanel Grid.Column="2" Margin="28,0,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel x:Name="Tally" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <local:TrackedText x:Name="FindingsLabel" Source="ЗАМЕЧАНИЯ" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Rectangle DockPanel.Dock="Top" Style="{StaticResource Hairline}" Fill="{StaticResource LineStrong}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                            <ScrollViewer.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="Black"/><GradientStop Offset="0.93" Color="Black"/><GradientStop Offset="1" Color="Transparent"/></LinearGradientBrush></ScrollViewer.OpacityMask>
                            <StackPanel x:Name="FindingList" Margin="0,0,0,30"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ===================== НИЖНЯЯ ПОЛОСА ===================== -->
            <Border Grid.Row="2" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,1,0,0" Margin="32,0" Padding="0,14,0,18">
                <DockPanel>
                    <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Перейти к программе" Margin="0"
                            Click="Done_Click" Visibility="Hidden" IsDefault="True"/>
                    <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="Осмотр только читает данные и ничего не меняет в системе."/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
