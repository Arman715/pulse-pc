<Window x:Class="PulsePC.LogDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulsePC"
        Title="Пульс ПК — подробнее" Width="760" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="540" MinHeight="420" ShowInTaskbar="True"
        Background="{DynamicResource Base}" Foreground="{DynamicResource Ink1}"
        FontFamily="{StaticResource TextFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== ЗАГОЛОВОК ОКНА ===================== -->
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoLogo}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                          Width="24" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Пульс ПК" Style="{StaticResource Brand}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource LineStrong}" Margin="18,0,16,0"/>
                    <TextBlock Text="Подробнее и что делать" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"/>
                <Rectangle Height="1" Fill="{DynamicResource LineStrong}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- ===================== ЛИСТ ===================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,22,22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="700"/>
                        <ColumnDefinition Width="0.0001*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <local:StateMarker x:Name="Mark" Level="Warn" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,11,12,0"/>
                            <TextBlock x:Name="Heading" Style="{StaticResource Verdict}"/>
                        </DockPanel>
                        <TextBlock x:Name="Intro" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="Loading" Style="{StaticResource Caption}" Margin="0,16,0,0" Text="Читаю журнал Windows…"/>

                        <StackPanel x:Name="Body" Visibility="Collapsed">
                            <local:TrackedText Source="ЧТО ЭТО ЗНАЧИТ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                            <Rectangle Style="{StaticResource Hairline}"/>
                            <TextBlock x:Name="Meaning" Style="{StaticResource Body}" Margin="0,10,0,0"/>

                            <local:TrackedText Source="ЧТО ДЕЛАТЬ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                            <Rectangle Style="{StaticResource Hairline}"/>
                            <StackPanel x:Name="Steps"/>

                            <StackPanel x:Name="DisksBlock" Visibility="Collapsed">
                                <local:TrackedText Source="ДИСКИ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                                <Rectangle Style="{StaticResource Hairline}"/>
                                <StackPanel x:Name="Disks"/>
                            </StackPanel>

                            <local:TrackedText Source="ЗАПИСИ ЖУРНАЛА" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                            <Rectangle Style="{StaticResource Hairline}"/>
                            <TextBlock x:Name="EventsCaption" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                            <StackPanel x:Name="Events"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ===================== НИЗ ===================== -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,1,0,0" Padding="32,14,32,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Закрыть" Margin="0,0,10,0" Click="Close_Click"/>
                        <Button x:Name="BtnOpen" Style="{StaticResource Primary}" Content="Открыть в «Просмотре событий»" Click="Open_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="Footer" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"
                               Text="Журналы Windows только читаются: записи копируются во временный файл и открываются в «Просмотре событий»."/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
