<Window x:Class="PulsePC.WhySlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulsePC"
        Title="Пульс ПК — почему тормозит" Width="720" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="520" MinHeight="420" ShowInTaskbar="True"
        Background="{DynamicResource Base}" Foreground="{DynamicResource Ink1}"
        FontFamily="{StaticResource TextFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== ЗАГОЛОВОК ОКНА ===================== -->
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoLogo}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                          Width="24" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Пульс ПК" Style="{StaticResource Brand}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource LineStrong}" Margin="18,0,16,0"/>
                    <TextBlock Text="Почему тормозит" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"/>
                <Rectangle Height="1" Fill="{DynamicResource LineStrong}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- ===================== ЛИСТ ===================== -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Лист во всю доступную ширину (до 660), прижат влево: иначе ширину задавала бы самая длинная строка текста,
                     и справа у таблиц оставалось поле больше левого. -->
                <Grid Margin="32,22,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="660"/>
                    <ColumnDefinition Width="0.0001*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <local:StateMarker x:Name="Mark" Level="Info" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,11,12,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="Heading" Style="{StaticResource Verdict}" Text="Смотрю, что нагружает компьютер…"/>
                    </DockPanel>
                    <TextBlock x:Name="Intro" Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="Пять секунд: процессор, видеокарта, память, диски, сеть и самые активные программы. Ничего не меняется и не закрывается."/>
                    <local:ThinBar x:Name="Progress" Height="3" Fill="{DynamicResource Ink1}" Margin="0,16,0,0"/>

                    <!-- Причины и что сделать -->
                    <StackPanel x:Name="CausesBlock" Visibility="Collapsed">
                        <local:TrackedText Source="ЧТО МЕШАЕТ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                        <Rectangle Style="{StaticResource Hairline}"/>
                        <StackPanel x:Name="Causes"/>
                    </StackPanel>
                    <TextBlock x:Name="ActionResult" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed"/>

                    <!-- Показания -->
                    <StackPanel x:Name="ReadingsBlock" Visibility="Collapsed">
                        <local:TrackedText Source="ПОКАЗАНИЯ ЗА ПЯТЬ СЕКУНД" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                        <Rectangle Style="{StaticResource Hairline}"/>
                        <StackPanel x:Name="Readings"/>
                    </StackPanel>

                    <!-- Программы -->
                    <StackPanel x:Name="ProcsBlock" Visibility="Collapsed">
                        <local:TrackedText Source="САМЫЕ АКТИВНЫЕ ПРОГРАММЫ" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                        <Rectangle Style="{StaticResource Hairline}"/>
                        <Grid Margin="0,8,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="процессор" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="диск" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="память" TextAlignment="Right"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"/>
                        <StackPanel x:Name="Procs"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="Закрыть можно только обычную программу с окном — после вашего подтверждения. Части Windows, защитные программы и античиты программа не закрывает никогда."/>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ===================== НИЗ ===================== -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,1,0,0" Padding="32,14,32,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnClose" Content="Закрыть" Margin="0,0,10,0" Click="Close_Click"/>
                        <Button x:Name="BtnAgain" Style="{StaticResource Primary}" Content="Проверить ещё раз" Click="Again_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="Footer" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
